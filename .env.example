# Copy this file to .env and fill in real values. Never commit .env; it is
# already in .gitignore. This file lists variable names only, never values.

# --- Vision provider ---
# "fake" (default) needs no key and makes no network call; use it for
# development and for the test suite. "anthropic" calls the real API.
VISION_PROVIDER=fake
VISION_MODEL=
ANTHROPIC_API_KEY=

# --- Server ---
PORT=3000

# --- Image storage (issue 2), off by default ---
STORE_IMAGES=false
STORE_RETENTION_MINUTES=10
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=

# --- Rate limiting (issue 2) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_WINDOW=10
DAILY_CAP_WINDOW_MS=86400000
DAILY_CALL_CAP=500

# --- Upload and answer limits ---
MAX_UPLOAD_BYTES=8388608
MAX_QUESTION_LENGTH=300
MAX_ANSWER_LENGTH=400

# --- Image preprocessing (issue 6) ---
IMAGE_MAX_DIM=1092
IMAGE_JPEG_QUALITY=80

# --- Frame usability check ---
FRAME_MIN_MEAN_LUMINANCE=10
FRAME_MIN_STDDEV=4
