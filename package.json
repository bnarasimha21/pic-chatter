{
  "name": "picchatter",
  "version": "2.0.0",
  "description": "A small Express app that answers spoken questions about a captured picture, grounded in a pluggable vision provider",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test test/e2e",
    "eval": "node eval/run.js",
    "eval:make-images": "node eval/make_images.js"
  },
  "keywords": [
    "image",
    "chat",
    "vision",
    "express",
    "ejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "dotenv": "^16.4.7",
    "ejs": "^7.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "private": true
}
