<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PicChatter</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      max-width: 700px;
      margin: 0 auto;
    }
    h1 { text-align: center; }
    .status {
      font-size: 14px;
      color: #555;
      text-align: center;
      margin-bottom: 10px;
    }
    .provider-note {
      font-size: 12px;
      color: #888;
      text-align: center;
      margin-bottom: 10px;
    }
    #consentOverlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }
    #consentOverlay.hidden { display: none; }
    .consent-box {
      background: white;
      border-radius: 8px;
      padding: 24px;
      max-width: 420px;
      text-align: left;
    }
    .consent-box h2 { margin-top: 0; }
    .consent-box .consent-actions {
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }
    #app.hidden { display: none; }
    .camera-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    video, canvas, #capturedPreview {
      max-width: 100%;
      border-radius: 6px;
      background: #000;
    }
    canvas { display: none; }
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin: 14px 0;
    }
    button {
      border: none;
      border-radius: 6px;
      padding: 10px 16px;
      font-size: 15px;
      cursor: pointer;
    }
    #micButton { background: #007bff; color: white; }
    #micButton.listening { background: #28a745; }
    #captureButton { background: #6f42c1; color: white; }
    #stopButton { background: #dc3545; color: white; }
    #stopButton:disabled { background: #ccc; cursor: not-allowed; }
    .text-fallback {
      display: flex;
      gap: 8px;
      margin: 10px 0;
    }
    .text-fallback input {
      flex-grow: 1;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }
    .chat-log {
      border: 1px solid #ddd;
      border-radius: 6px;
      padding: 12px;
      min-height: 120px;
      max-height: 300px;
      overflow-y: auto;
      background: #f8f9fa;
    }
    .message { margin: 6px 0; padding: 8px 12px; border-radius: 10px; }
    .message.user { background: #007bff; color: white; }
    .message.bot { background: #e9ecef; }
  </style>
</head>
<body>
  <h1>PicChatter</h1>
  <div class="provider-note">Vision provider: <%= visionProvider %></div>
  <div class="status" id="status">Loading...</div>

  <!-- CONSENT GATE: camera/mic never start until this is accepted -->
  <div id="consentOverlay">
    <div class="consent-box">
      <h2>Before we start</h2>
      <p>
        PicChatter sends the picture you capture, and the question you ask
        about it, to <strong><%= visionProvider %></strong> so it can
        answer.
      </p>
      <p>
        <% if (storeImages) { %>
          Image storage is currently <strong>on</strong> for this server:
          the picture is kept for about <strong><%= retentionMinutes %>
          minute<%= retentionMinutes === 1 ? '' : 's' %></strong> and then
          deleted. See the readme for exactly what that deletion does and
          does not guarantee.
        <% } else { %>
          Image storage is currently <strong>off</strong> for this server:
          the picture goes to the vision provider and is not saved
          anywhere by this app.
        <% } %>
        Nothing is sent until you capture a picture and ask a question.
      </p>
      <div class="consent-actions">
        <button id="consentAccept">I understand, continue</button>
        <button id="consentDecline" style="background:#aaa;color:white;">No thanks</button>
      </div>
    </div>
  </div>

  <div id="app" class="hidden">
    <div class="camera-wrap">
      <video id="cameraPreview" autoplay playsinline muted width="480" height="360"></video>
      <canvas id="captureCanvas" width="480" height="360"></canvas>
      <img id="capturedPreview" alt="Last captured frame" style="display:none;" width="240" />
    </div>

    <div class="controls">
      <button id="captureButton">Capture picture</button>
      <button id="micButton" style="display:none;">Ask by voice</button>
      <button id="stopButton" disabled>Stop</button>
      <button id="withdrawConsentButton" style="background:#aaa;color:white;">Withdraw consent</button>
    </div>

    <form class="text-fallback" id="textForm">
      <input type="text" id="textQuestion" placeholder="Type your question about the captured picture" maxlength="300" />
      <button type="submit" id="textSubmit">Ask</button>
    </form>

    <div class="chat-log" id="chatLog"></div>
  </div>

  <script src="/public/js/consent.js"></script>
  <script src="/public/js/state.js"></script>
  <script src="/public/js/askClient.js"></script>
  <script>
    (function () {
      'use strict';

      const statusEl = document.getElementById('status');
      const consentOverlay = document.getElementById('consentOverlay');
      const consentAccept = document.getElementById('consentAccept');
      const consentDecline = document.getElementById('consentDecline');
      const appEl = document.getElementById('app');
      const cameraPreview = document.getElementById('cameraPreview');
      const captureCanvas = document.getElementById('captureCanvas');
      const capturedPreview = document.getElementById('capturedPreview');
      const captureButton = document.getElementById('captureButton');
      const micButton = document.getElementById('micButton');
      const stopButton = document.getElementById('stopButton');
      const textForm = document.getElementById('textForm');
      const textQuestion = document.getElementById('textQuestion');
      const chatLog = document.getElementById('chatLog');
      const withdrawConsentButton = document.getElementById('withdrawConsentButton');

      // Built from the server-rendered facts the consent notice actually
      // showed, so a stored consent only counts for exactly those facts.
      // If the server config changes (provider swapped, storage toggled),
      // this fingerprint changes too and the stored consent no longer
      // matches, so the notice is shown again instead of silently carrying
      // over consent given to a different setup.
      const consentFingerprint = Consent.buildFingerprint({
        // JSON.stringify, not plain HTML-escaped interpolation: this value
        // lands inside a JS string literal, not HTML text, so a provider
        // name containing a quote or backslash would otherwise either
        // break the script or (with HTML-escaping alone) produce a
        // fingerprint string that can never match the one the server
        // computes from the raw name, silently disabling storage.
        provider: <%- JSON.stringify(visionProvider) %>,
        storeImages: <%= storeImages ? 'true' : 'false' %>,
        retentionMinutes: <%= Number(retentionMinutes) || 0 %>
      });

      let uiState = PicChatterState.INITIAL_STATE;
      let currentImageBlob = null;
      let currentImagePreviewUrl = null;
      let currentController = null;
      let recognition = null;
      let currentUtterance = null;
      // Bumped every time consent is withdrawn, and read by startCamera()
      // right after its getUserMedia() promise resolves. getUserMedia is
      // async and can resolve well after a withdraw click (the permission
      // prompt itself can sit open for seconds), so stopCameraTracks()
      // alone - which only stops tracks on a stream already assigned to
      // cameraPreview.srcObject - misses a stream that is still in flight
      // at the moment consent is withdrawn.
      //
      // A plain boolean flag is not enough here: withdraw -> re-consent
      // while the original getUserMedia() call is still pending would
      // reset a boolean back to "not withdrawn" before that stale call
      // resolves, so its now-obsolete stream would still land on the
      // video element and silently replace (without stopping) the stream
      // from the new, current startCamera() call. A generation counter
      // instead lets each call compare the value it captured when it
      // started against the current value, so only the most recent call
      // ever wins, regardless of how the withdraw/re-consent clicks and
      // the getUserMedia() resolutions end up interleaved.
      let cameraGeneration = 0;

      function dispatch(actionType) {
        uiState = PicChatterState.reduce(uiState, { type: actionType });
        render();
      }

      function render() {
        statusEl.textContent = {
          idle: 'Capture a picture, then ask a question.',
          listening: 'Listening...',
          asking: 'Thinking...',
          speaking: 'Speaking the answer...',
          error: 'Something went wrong. Try again.'
        }[uiState] || uiState;

        micButton.classList.toggle('listening', uiState === 'listening');
        stopButton.disabled = uiState === 'idle';
        micButton.disabled = uiState === 'asking' || uiState === 'speaking';
        textQuestion.disabled = uiState === 'asking' || uiState === 'speaking';
      }

      function addMessage(text, isUser) {
        const div = document.createElement('div');
        div.className = `message ${isUser ? 'user' : 'bot'}`;
        div.textContent = text;
        chatLog.appendChild(div);
        chatLog.scrollTop = chatLog.scrollHeight;
      }

      // --- Consent gate ---
      function hasConsent() {
        try {
          return Consent.hasConsented(window.localStorage, consentFingerprint);
        } catch (err) {
          return false;
        }
      }

      function showApp() {
        consentOverlay.classList.add('hidden');
        appEl.classList.remove('hidden');
        startCamera();
        setupSpeechRecognition();
        render();
      }

      function stopCameraTracks() {
        const stream = cameraPreview.srcObject;
        if (stream && typeof stream.getTracks === 'function') {
          stream.getTracks().forEach((track) => track.stop());
        }
        cameraPreview.srcObject = null;
      }

      // Clears the captured frame along with the camera feed on withdrawal.
      // Without this, a photo captured before consent was withdrawn stays
      // in currentImageBlob and capturedPreview, so re-consenting without
      // taking a fresh picture would still let that stale photo be asked
      // about and (if storage is on) uploaded.
      function clearCapturedImage() {
        currentImageBlob = null;
        if (currentImagePreviewUrl) {
          URL.revokeObjectURL(currentImagePreviewUrl);
          currentImagePreviewUrl = null;
        }
        capturedPreview.removeAttribute('src');
        capturedPreview.style.display = 'none';
      }

      if (hasConsent()) {
        showApp();
      } else {
        render();
      }

      consentAccept.addEventListener('click', () => {
        Consent.recordConsent(window.localStorage, consentFingerprint);
        showApp();
      });

      consentDecline.addEventListener('click', () => {
        statusEl.textContent = 'Camera and microphone access are needed to use PicChatter.';
      });

      // --- Withdraw consent: stop everything and re-show the notice ---
      withdrawConsentButton.addEventListener('click', () => {
        // Invalidates any startCamera() call already in flight (its
        // captured generation can never match this new value), so a
        // stream granted after this point can never land on the page,
        // no matter how it interleaves with a later re-consent.
        cameraGeneration++;
        if (currentController) currentController.abort();
        if (recognition && uiState === 'listening') recognition.abort();
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        currentUtterance = null;
        stopCameraTracks();
        clearCapturedImage();
        Consent.clearConsent(window.localStorage);
        appEl.classList.add('hidden');
        consentOverlay.classList.remove('hidden');
        dispatch('STOP');
      });

      // --- Camera capture ---
      async function startCamera() {
        const myGeneration = cameraGeneration;
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: true });
          // Consent can be withdrawn (or withdrawn and re-granted) while
          // this permission prompt/request is still pending; comparing
          // the generation captured above against the current one, right
          // here, is what stops a stream granted after that from ever
          // reaching the page, and stops it from silently clobbering a
          // newer call's stream without stopping it.
          if (myGeneration !== cameraGeneration) {
            stream.getTracks().forEach((track) => track.stop());
            return;
          }
          cameraPreview.srcObject = stream;
        } catch (err) {
          console.error('Could not start camera:', err);
          statusEl.textContent = 'Could not access the camera. You can still type a question once you have an image another way.';
        }
      }

      captureButton.addEventListener('click', () => {
        const myGeneration = cameraGeneration;
        const ctx = captureCanvas.getContext('2d');
        ctx.drawImage(cameraPreview, 0, 0, captureCanvas.width, captureCanvas.height);
        captureCanvas.toBlob((blob) => {
          // toBlob's callback fires asynchronously, so a capture clicked
          // immediately before a withdraw can otherwise land after
          // clearCapturedImage() has already run, leaving a stale image
          // in place right after withdrawal. Checking the generation
          // here, the same way startCamera() does, discards a capture
          // that belongs to a session consent has since withdrawn from.
          if (myGeneration !== cameraGeneration) return;
          currentImageBlob = blob;
          if (currentImagePreviewUrl) URL.revokeObjectURL(currentImagePreviewUrl);
          currentImagePreviewUrl = URL.createObjectURL(blob);
          capturedPreview.src = currentImagePreviewUrl;
          capturedPreview.style.display = 'block';
        }, 'image/jpeg', 0.85);
      });

      // --- Speech recognition, with a text-input fallback when unsupported ---
      function setupSpeechRecognition() {
        const SpeechRecognitionImpl = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognitionImpl) {
          micButton.style.display = 'none';
          return;
        }

        micButton.style.display = 'inline-block';
        recognition = new SpeechRecognitionImpl();
        recognition.lang = 'en-US';
        recognition.continuous = false;
        recognition.interimResults = false;

        recognition.addEventListener('result', (event) => {
          // Defense in depth: real Chrome's SpeechRecognition can deliver a
          // trailing 'result' event even after .abort() is called (the
          // engine may already have a result in flight at the moment
          // abort() is invoked). The app's own state is the source of
          // truth for whether the user is still actually listening; if
          // it is not 'listening' anymore (Stop was pressed, or a listen
          // session already ended for any other reason), this result
          // belongs to a session the user has already asked to cancel and
          // must be discarded rather than turned into a captured photo
          // being sent to the vision provider (and possibly stored)
          // without the user's consent to that specific submission.
          if (uiState !== 'listening') return;
          const transcript = event.results[0][0].transcript;
          dispatch('SPEECH_RESULT');
          askQuestion(transcript);
        });

        recognition.addEventListener('error', () => {
          dispatch('ASK_ERROR');
        });

        recognition.addEventListener('end', () => {
          if (uiState === 'listening') dispatch('STOP');
        });
      }

      micButton.addEventListener('click', () => {
        if (uiState === 'listening') {
          recognition.abort();
          dispatch('STOP');
          return;
        }
        if (!currentImageBlob) {
          statusEl.textContent = 'Capture a picture first.';
          return;
        }
        dispatch('START_LISTEN');
        recognition.start();
      });

      // --- Text-input fallback: same askQuestion() path as voice ---
      textForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const question = textQuestion.value.trim();
        if (!question) return;
        if (!currentImageBlob) {
          statusEl.textContent = 'Capture a picture first.';
          return;
        }
        // Typing and submitting a question while the mic is still
        // listening must stop the mic first, the same way the Stop button
        // and the mic button's own "click while listening" case already
        // do (recognition.abort() + dispatch('STOP')). Without this, the
        // reducer has no ASK_START transition defined for the 'listening'
        // state (see state.js), so a bare dispatch('ASK_START') here would
        // silently no-op and leave uiState stuck on 'listening' while
        // askQuestion() still runs for the typed question. That leaves a
        // live recognition in flight that can still deliver a trailing
        // 'result' event, firing a second, concurrent askQuestion() call
        // for whatever was spoken, since the result handler only skips
        // stale results when uiState !== 'listening' and it never left
        // that state.
        if (recognition && uiState === 'listening') {
          recognition.abort();
          dispatch('STOP');
        }
        dispatch('ASK_START');
        askQuestion(question);
        textQuestion.value = '';
      });

      // --- The one path both voice and text funnel into ---
      async function askQuestion(question) {
        addMessage(question, true);
        currentController = new AbortController();

        try {
          // Reaching this call means the consent overlay was already
          // accepted (showApp() is the only path that enables capture and
          // asking), so this request carries consent: true. A direct POST
          // to /ask that skips this page entirely has no such client
          // record, which is exactly why the server re-checks consent
          // itself rather than trusting this flag alone.
          const { status, body } = await PicChatterAsk.postAsk(
            window.location.origin,
            currentImageBlob,
            'capture.jpg',
            question,
            currentController.signal,
            true,
            consentFingerprint
          );

          if (status !== 200 || !body || !body.answer) {
            dispatch('ASK_ERROR');
            addMessage((body && body.error) || 'Sorry, something went wrong.', false);
            return;
          }

          dispatch('ASK_SUCCESS');
          addMessage(body.answer.answer, false);
          speak(body.answer.answer);
        } catch (err) {
          if (err && err.name === 'AbortError') {
            // The user hit stop; state is already idle from the STOP action.
            return;
          }
          dispatch('ASK_ERROR');
          addMessage('Sorry, something went wrong reaching the server.', false);
        } finally {
          currentController = null;
        }
      }

      // --- Text-to-speech, using the browser's own speechSynthesis ---
      function speak(text) {
        if (!('speechSynthesis' in window)) {
          dispatch('SPEAK_END');
          return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        currentUtterance = utterance;
        utterance.addEventListener('end', () => {
          if (currentUtterance === utterance) {
            currentUtterance = null;
            dispatch('SPEAK_END');
          }
        });
        utterance.addEventListener('error', () => {
          if (currentUtterance === utterance) {
            currentUtterance = null;
            dispatch('SPEAK_END');
          }
        });
        window.speechSynthesis.speak(utterance);
      }

      // --- Stop button: aborts an in-flight ask, cancels speech, and stops listening ---
      stopButton.addEventListener('click', () => {
        if (currentController) currentController.abort();
        if (recognition && uiState === 'listening') recognition.abort();
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        currentUtterance = null;
        dispatch('STOP');
      });

      render();
    }());
  </script>
</body>
</html>
